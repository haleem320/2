# ============================================================
# MEXC Futures Bot v34.9.2
# ============================================================
# SAFETY: Both REAL_TRADING_ENABLED and AUTO_TRADING_ENABLED must be
# true for a live order to be sent. Keep them OFF while testing signals.
REAL_TRADING_ENABLED=false
AUTO_TRADING_ENABLED=false

# Required for /api/order, /api/preflight, /api/auto-run, etc.
# Set to a long random string (min 32 chars). Never commit the real one.
BOT_ADMIN_TOKEN=

# MEXC API credentials (Futures). Never commit.
MEXC_ACCESS_KEY=
MEXC_SECRET_KEY=

# ============================================================
# Runtime / scheduler
# ============================================================
SMART_PULLBACK_PROFILE=true
AUTO_INTERVAL_MINUTES=5
TRADE_MANAGER_ENABLED=true
TRADE_MANAGER_INTERVAL_SECONDS=10
AUTO_RUN_STALE_MS=480000
BOT_TIMEZONE=Asia/Kabul
BOT_STATE_FILE=/data/bot-state-v34.json

# ============================================================
# Position & risk limits (hard caps)
# ============================================================
POSITION_LIMIT_ENABLED=true
MAX_OPEN_POSITIONS=3
MAX_SAME_DIRECTION_POSITIONS=3
MAX_PREFLIGHT_CANDIDATES=15
MAX_TRADES_PER_DAY=12
MAX_LOSS_STREAK=3

# ============================================================
# Order sizing
# ============================================================
MAX_ORDER_USDT=5
ADAPTIVE_ORDER_SIZE=true
ORDER_BALANCE_RESERVE_USDT=0.20
MIN_ADAPTIVE_ORDER_USDT=1.50
TARGET_LEVERAGE=12

# MEXC may cap leverage below 20x for some contracts;
# the bot uses the contract max when lower.
OPEN_TYPE=1
POSITION_MODE=2

# ============================================================
# Direction engine (HTF majority + 1H confirmation + 15m entry)
LOW_FREQUENCY_MODE=true
REQUIRE_DAILY_ALIGNMENT=true
MIN_SIGNAL_SCORE=78
MIN_SCORE_EDGE=8
# ============================================================
INTERVAL=Min15
ADX_MIN=18
VOLUME_MULTIPLIER=1.15
SR_LOOKBACK=50

# ============================================================
# Breakout / pullback / wick entry
# ============================================================
BREAKOUT_REQUIRE_VOLUME=true
BREAKOUT_LOOKBACK=20
BREAKOUT_VOLUME_MULTIPLIER=1.08
BREAKOUT_MIN_BODY_ATR=0.20
BREAKOUT_MIN_BODY_RATIO=0.30
BREAKOUT_CLOSE_LOCATION_MIN=0.60
BREAKOUT_MAX_EXTENSION_ATR=1.25
BREAKOUT_MIN_SCORE=65

# Anti-chase / no-late-entry
ENTRY_MAX_IMPULSE_ATR=2.50
ENTRY_EXTREME_PROXIMITY_ATR=0.60
ENTRY_MIN_REAL_PULLBACK_ATR=0.60
ENTRY_MAX_RETEST_AGE_BARS=6

# Structure stop
STRUCTURE_STOP_BUFFER_ATR=0.25
STRUCTURE_STOP_MIN_PCT=0.008
MAX_STRUCTURE_STOP_PCT=0.025

# Risk / reward
MIN_RISK_REWARD=1.25

# Spread / liquidity / volatility
LIQUIDITY_MIN_24H_USDT=50000
MAX_SPREAD_PCT=0.003
VOLATILITY_SPIKE_ATR_MULTIPLIER=2.5

# ============================================================
# Take-profit / trailing
# ============================================================
TAKE_PROFIT_PCT=0.02
ADAPTIVE_TP_ENABLED=true
ADAPTIVE_TP_MAX_PCT=0.15
ADAPTIVE_TP_STEP_PCT=0.02
ADAPTIVE_TP_EXTEND_TRIGGER_PCT=0.02

BREAK_EVEN_ENABLED=true
BREAK_EVEN_TRIGGER_PCT=0.020
BREAK_EVEN_OFFSET_PCT=0.0015

TRAILING_STOP_ENABLED=true
TRAILING_TRIGGER_PCT=0.03
TRAILING_STOP_PCT=0.012
MIN_STOP_DISTANCE_PCT=0.001

# ============================================================
# Scan / universe
# ============================================================
# SCAN_BATCH_SIZE controls how many symbols are deep-analyzed per cycle.
# The universe is refreshed every 5 minutes from MEXC; symbols are rotated
# across cycles so the full active USDT universe is covered over time.
SCAN_BATCH_SIZE=300
FAST_SCAN_CONCURRENCY=12
DEEP_SCAN_CANDIDATES=60
UNIVERSE_MIN_24H_USDT=0
UNIVERSE_REFRESH_TTL_MS=300000
TRADING_SYMBOLS=BTC_USDT,ETH_USDT,BNB_USDT,SOL_USDT,XRP_USDT

# ============================================================
# MEXC rate limits
# ============================================================
MEXC_MIN_REQUEST_GAP_MS=110
MEXC_MAX_RETRIES=4

# ============================================================
# News risk (RSS)
# ============================================================
NEWS_RISK_ENABLED=true
NEWS_RISK_LOOKBACK_MINUTES=90
NEWS_BLOCK_RISK_SCORE=2
